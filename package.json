{
  "name": "dsh-paranim",
  "version": "0.7.1",
  "description": "dsh-paranim（他化自在天）: a DeepSeek Harness web plugin that runs an editable multi-agent town sandbox. Sidebar tabs register through ctx.betterSidebar; the host half owns the JSON sandbox store, a tick engine driving every agent through ctx.llm on a per-agent model route, and a D6 attribute adjudication engine (STR/CON/DEX/APP/INT/POW vs difficulty). The map renders from an inline pixel-art sprite table (tiles, buildings, walkers, props) with right-click object state editing, user directives, and manual / auto world steppers. Ships a recreated Stanford Smallville mirror.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test --experimental-strip-types \"src/**/*.test.ts\"",
    "selftest": "node src/host/selftest.ts",
    "gen:fallback": "node scripts/gen-fallback.mjs",
    "check": "npm run typecheck && npm run test && npm run selftest && npm run build",
    "install:profile": "bash scripts/install.sh",
    "uninstall:profile": "bash scripts/uninstall.sh",
    "migrate:fields": "node scripts/migrate-drop-fields.mjs",
    "assets:normalize": "node scripts/normalize-assets.mjs",
    "assets:snapshot": "node scripts/snapshot-assets.mjs",
    "assets:inspect": "node scripts/inspect-sheet.mjs",
    "assets:all": "node scripts/normalize-assets.mjs && node scripts/snapshot-assets.mjs",
    "find-tile": "node scripts/find-tile.mjs",
    "assets:house": "node scripts/gen-house-sandbox.mjs"
  },
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "plugin",
    "web",
    "dsh-better-sidebar",
    "multi-agent",
    "sandbox",
    "smallville",
    "generative-agents",
    "他化自在天",
    "小镇"
  ],
  "license": "MIT",
  "files": [
    "lib",
    "assets",
    "cordis.patch.yml",
    "scripts",
    "README.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@types/node": "^26.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "esbuild": "^0.24.2",
    "typescript": "^5.6.0"
  }
}
