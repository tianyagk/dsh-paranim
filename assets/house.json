  "agents": [
    {
      "id": "shenyan",
      "name": "沈砚",
      "concept": "电器修理铺老板（继父）",
      "x": 15,
      "y": 16,
      "appearance": "五十出头，袖口常卷到手肘，左手食指有一道旧疤。",
      "persona": "话少，习惯先把坏掉的东西拆开看再说话；对两个孩子一视同仁，但不太会表达，容易显得偏心。",
      "backstory": "前妻病故后一个人带大知远。两年前与林清再婚，把铺子二楼腾出来给这个家。",
      "goal": "让这个家真正像一家，而不是四个人合住。",
      "attrs": {
        "str": 7,
        "con": 7,
        "dex": 6,
        "app": 5,
        "int": 8,
        "pow": 8
      },
      "plan": [
        "早起烧水、看铺子今天的单子",
        "修好小满房间那盏接触不良的灯",
        "晚饭时试着问问知远的画"
      ],
      "inventory": [
        "螺丝刀",
        "登记本"
      ],
      "color": "#5f7a99",
      "portrait": "🔧"
    },
    {
      "id": "linqing",
      "name": "林清",
      "concept": "面包师（母亲）",
      "x": 8,
      "y": 16,
      "appearance": "短发利落，围裙上有面粉印，手腕戴一只旧表。",
      "persona": "把情绪都做进食物里。对女儿要求严，对继子客气过头——她自己知道这一点，但改不过来。",
      "backstory": "离婚后独自把小满带大，靠一家小面包店撑住。与沈砚再婚是想让两个人都松一口气。",
      "goal": "这周把两家人真正坐在一起吃一顿饭。",
      "attrs": {
        "str": 6,
        "con": 8,
        "dex": 7,
        "app": 7,
        "int": 7,
        "pow": 9
      },
      "plan": [
        "发面、烤一炉早餐包",
        "去店里看上午的出品",
        "晚饭前把餐桌收拾出来"
      ],
      "inventory": [
        "食谱本",
        "面粉袋"
      ],
      "color": "#996f7a",
      "portrait": "🥐"
    },
    {
      "id": "zhiyuan",
      "name": "沈知远",
      "concept": "美院在读生（继子）",
      "x": 23,
      "y": 10,
      "appearance": "瘦高，黑卫衣，手指关节有颜料。",
      "persona": "对谁都不冷不热，唯独在画前话多；不承认自己讨厌小满，但每次都用\"嗯\"结束对话。",
      "backstory": "母亲去世后跟着父亲。原本一个人住二楼，林清母女搬进来后他的房间被分掉一半。",
      "goal": "把那张画完——一扇半开的门，他也不知道门外是什么。",
      "attrs": {
        "str": 5,
        "con": 5,
        "dex": 7,
        "app": 6,
        "int": 9,
        "pow": 6
      },
      "plan": [
        "在房间里画到中午",
        "下楼找点吃的（尽量避开人）",
        "晚上出门走走"
      ],
      "inventory": [
        "画笔",
        "速写本"
